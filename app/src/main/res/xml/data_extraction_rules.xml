<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens are sealed with a device-bound Keystore key: never back them up or move them to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.lamls.vocabflow.auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.lamls.vocabflow.auth.xml" />
    </device-transfer>
</data-extraction-rules>
